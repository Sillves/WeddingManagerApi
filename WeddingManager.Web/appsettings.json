{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Frontend": {
    "BaseUrl": "https://amare.wedding"
  },
  "SubscriptionPlans": {
    "Plans": {
      "Free": {
        "MaxGuests": 50,
        "MaxEvents": 2,
        "MaxEmailsPerMonth": 0,
        "Features": [
          "guests",
          "events"
        ]
      },
      "Starter": {
        "MaxGuests": 200,
        "MaxEvents": 5,
        "MaxEmailsPerMonth": 300,
        "Features": [
          "guests",
          "events",
          "emails", 
          "website_builder"
        ]
      },
      "Pro": {
        "MaxGuests": -1,
        "MaxEvents": -1,
        "MaxEmailsPerMonth": -1,
        "Features": [
          "guests",
          "events",
          "emails",
          "priority_support",
          "website_builder"
        ]
      }
    }
  }
}
