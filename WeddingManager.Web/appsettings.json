{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Frontend": {
    "BaseUrl": "https://amare.wedding"
  },
  "SubscriptionPlans": {
    "Plans": {
      "Free": {
        "MaxGuests": 50,
        "MaxEvents": 5,
        "MaxEmailsPerMonth": 100,
        "Features": [
          "guests",
          "events",
          "emails"
        ]
      },
      "Starter": {
        "MaxGuests": 200,
        "MaxEvents": 20,
        "MaxEmailsPerMonth": 500,
        "Features": [
          "guests",
          "events",
          "emails",
          "custom_domain"
        ]
      },
      "Pro": {
        "MaxGuests": -1,
        "MaxEvents": -1,
        "MaxEmailsPerMonth": -1,
        "Features": [
          "guests",
          "events",
          "emails",
          "custom_domain",
          "priority_support"
        ]
      }
    }
  }
}
