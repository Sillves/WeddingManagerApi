meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "email": "{{$randomFirstName}}@hotmail.com",
    "firstName": "{{$randomFirstName}}", 
    "lastName": "{{$randomLastName}}",
    "password": "{{$randomFirstName}}123"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
