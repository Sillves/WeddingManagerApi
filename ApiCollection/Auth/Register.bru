meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "email": "{{$randomFirstName}}@hotmail.com",
    "firstName": "{{$randomFirstName}}", 
    "lastName": "{{$randomLastName}}",
    "password": "{{$randomFirstName}}{{$randomLastName}}123"
  }
}

script:post-response {
  let data = res.body;
  console.log(data)
  bru.setEnvVar("authToken", data.token);
  
}

settings {
  encodeUrl: true
  timeout: 0
}
