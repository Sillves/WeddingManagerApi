meta {
  name: CreateGuest
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/weddings/{{weddingId}}/guests
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{$randomFirstName}} {{$randomLastName}}",
    "email": "{{$randomFirstName}}{{$randomLastName}}@hotmail.com",
    "rsvpStatus": 0
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
