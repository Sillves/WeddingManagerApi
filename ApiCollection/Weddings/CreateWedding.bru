meta {
  name: CreateWedding
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/weddings
  body: json
  auth: inherit
}

body:json {
  {
    "title": "{{$randomFirstName}} & {{$randomFirstName}}",
    "date": "{{$randomDateFuture}}",
    "location": "{{$randomCity}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
