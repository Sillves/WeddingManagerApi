meta {
  name: CreateGuest
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/weddings/{{weddingId}}/guests
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "{{$randomFirstName}} {{$randomLastName}}",
    "email": "{{$randomEmail}}",
    "rsvpStatus": "Pending"
  }
}

settings {
  encodeUrl: false
  timeout: 0
}
